{
    "name": "ct-teilnehmerliste",
    "private": true,
    "version": "0.0.0",
    "description": "ChurchTools-Extension: Gruppe wählen, Mitglieder nach Familien zusammengefasst ansehen und als Excel herunterladen.",
    "license": "MIT",
    "type": "module",
    "churchtools": {
        "shorty": "teilnehmerliste",
        "moduleName": "Teilnehmerliste",
        "extensionKey": "teilnehmerliste",
        "rootElementId": "teilnehmerliste-app",
        "rootClassName": "teilnehmerliste-root"
    },
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write .",
        "typecheck": "vue-tsc -b",
        "test": "vitest run",
        "test:watch": "vitest",
        "check": "npm run lint && npm run typecheck && npm run test && npm run build",
        "deploy": "npm run build && node scripts/package.js",
        "gen:types": "node scripts/gen-ct-types.js"
    },
    "dependencies": {
        "@churchtools/churchtools-client": "^1.4.0",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.2.0",
        "eslint": "^9.17.0",
        "eslint-plugin-vue": "^9.32.0",
        "openapi-typescript": "^7.4.4",
        "prettier": "^3.4.2",
        "typescript": "^5.9.2",
        "vite": "^7.1.2",
        "vitest": "^5.0.5",
        "vue-tsc": "^2.1.10"
    }
}
